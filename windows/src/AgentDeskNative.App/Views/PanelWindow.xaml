<!-- macOS: AgentDeskNativePanel.swift -->
<Window x:Class="AgentDeskNative.Windows.Panel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" Title="AgentDesk Native" Width="340" Height="570" WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="{DynamicResource FontBody}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <AdornerDecorator><Grid>
 <Border x:Name="Backdrop" Background="{DynamicResource PanelFill}" CornerRadius="8"/>
 <Grid Margin="14" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontTitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>
 <Grid Grid.Row="1">
 <ScrollViewer x:Name="accountsView" Visibility="{Binding IsAccounts, Converter={StaticResource BoolVisibility}}"><local:AccountsPage/></ScrollViewer>
 <ScrollViewer x:Name="settingsView" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}"><local:SettingsPage/></ScrollViewer>
 <ScrollViewer x:Name="infoView" Visibility="{Binding IsInfo, Converter={StaticResource BoolVisibility}}"><local:InfoPage/></ScrollViewer>
 <ScrollViewer x:Name="addView" Visibility="{Binding IsAdd, Converter={StaticResource BoolVisibility}}"><local:NewAccountPage/></ScrollViewer>
 </Grid>
 <DockPanel Grid.Row="2" Margin="0,6,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" local:Icon.Kind="close" Command="{Binding ClearMessage}" ToolTip="关闭提示"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Amber}" FontSize="{DynamicResource FontMeta}" MaxHeight="34" TextTrimming="CharacterEllipsis"/></DockPanel>
 <StackPanel Grid.Row="3"><Separator Margin="0,8"/><DockPanel KeyboardNavigation.TabIndex="100">
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Command="{Binding Info}" local:Icon.Kind="info" ToolTip="信息" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsInfo}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding Settings}" local:Icon.Kind="settings" ToolTip="设置" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding TogglePet}" local:Icon.Kind="pet" ToolTip="桌宠" Margin="8,0,0,0" Visibility="{Binding PetEnabled, Converter={StaticResource BoolVisibility}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding PetVisible}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><Button Content="＋ 新建账号" Command="{Binding Add}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SubtleButton}"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding IsAdd}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DockPanel></StackPanel>
 </Grid></Grid></AdornerDecorator>
</Window>