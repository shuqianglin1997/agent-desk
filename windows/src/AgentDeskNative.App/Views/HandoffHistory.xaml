<!-- macOS: SettingsView.swift -->
<UserControl x:Class="AgentDeskNative.Windows.HandoffHistory" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" >
<StackPanel><ScrollViewer MaxHeight="220"><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" local:Icon.Kind="trash" Command="{Binding Forget}" ToolTip="删除记录，保留文档"/><Button Command="{Binding Open}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}"><StackPanel><TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontMeta}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Title}" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></Button></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Button Content="{Binding HistoryMore}" Command="{Binding MoreHistory}" Visibility="{Binding HasHistoryMore, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
</UserControl>
