<!-- macOS: QuotaRow.swift -->
<UserControl x:Class="AgentDeskNative.Windows.QuotaRows" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" >
<ItemsControl ItemsSource="{Binding Quotas}"><ItemsControl.ItemTemplate><DataTemplate>
 <Grid Margin="0,0,0,6" ToolTip="{Binding Tip}"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}"/>
 <TextBlock Grid.Column="1" Text="{Binding Percent}" Typography.NumeralAlignment="Tabular" local:ColorToken.Key="{Binding ColorKey}"/>
 <TextBlock Grid.Column="2" Text="{Binding Reset}" Style="{StaticResource Meta}" HorizontalAlignment="Right"/>
 </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
