<!-- macOS: AgentDeskNativePanel.swift / DiscoveredRow -->
<UserControl x:Class="AgentDeskNative.Windows.DiscoveredCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" >
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="×" Style="{StaticResource IconButton}" Command="{Binding Dismiss}" DockPanel.Dock="Right" ToolTip="不再提示"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/></DockPanel><Button  HorizontalAlignment="Left" Margin="0,8,0,0" Click="Choose"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Command" Value="{Binding Add}"/><Setter Property="Content" Value="添加为账号"/><Style.Triggers><DataTrigger Binding="{Binding HasAccounts}" Value="True"><Setter Property="Content" Value="选择账号 ▾"/><Setter Property="Command" Value="{x:Null}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border>
</UserControl>
