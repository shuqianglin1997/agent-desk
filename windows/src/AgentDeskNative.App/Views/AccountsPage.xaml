<!-- macOS: AgentDeskNativePanel.swift -->
<UserControl x:Class="AgentDeskNative.Windows.AccountsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" >
<StackPanel><local:HandoffCard/><ItemsControl ItemsSource="{Binding Discovered}"><ItemsControl.ItemTemplate><DataTemplate><local:DiscoveredCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="还没有账号。点下面的“新建账号”添加一个。" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding NoAccounts, Converter={StaticResource BoolVisibility}}"/>
 <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel>
 <Button Command="{Binding Toggle}" Padding="0,4" Margin="0,2,0,8" HorizontalContentAlignment="Stretch" local:DragSupport.Enabled="True" local:DragSupport.Target="True"><DockPanel>
 <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{DynamicResource TextTertiary}" RenderTransformOrigin="0.5,0.5"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Meta}" Margin="6,0"/><Grid Width="16" Height="16" Margin="0,0,6,0"><Border CornerRadius="8" Background="{DynamicResource ControlFill}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Initial}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Image Source="{Binding Icon}"/></Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/></DockPanel></Button>
 <ItemsControl ItemsSource="{Binding Accounts}" Visibility="{Binding Expanded, Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemTemplate><DataTemplate><local:AccountCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
</UserControl>
