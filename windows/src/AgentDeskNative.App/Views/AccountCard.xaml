<!-- macOS: AccountCard.swift -->
<UserControl x:Class="AgentDeskNative.Windows.AccountCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" >
<Border Style="{StaticResource Card}" local:DragSupport.Target="True" ContextMenuOpening="AccountMenu">
 <StackPanel>
 <Grid Margin="0,0,0,6" local:DragSupport.Enabled="True"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="NameCellSized"><TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="{DynamicResource FontAccount}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Ellipse Width="5" Height="5" Margin="6,0" Fill="{DynamicResource StatusGreen}" Visibility="{Binding Running, Converter={StaticResource BoolVisibility}}"/></StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding Cache}" Style="{StaticResource Meta}" VerticalAlignment="Center" ToolTip="{Binding QuotaTip}" MaxWidth="80" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
 <Button Grid.Column="2" Command="{Binding Refresh}" ToolTip="刷新额度" Margin="4,0" local:Icon.Kind="refresh"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 <Button Grid.Column="3" Content="{Binding OpenLabel}" Style="{StaticResource StandardButton}" Command="{Binding Open}"/>
 </Grid>
 <local:QuotaRows/>
 <TextBlock Text="{Binding QuotaDetail}" ToolTip="{Binding QuotaTip}" Style="{StaticResource Meta}" Margin="0,0,0,6" Visibility="{Binding HasQuotaDetail, Converter={StaticResource BoolVisibility}}"/>
 <ItemsControl ItemsSource="{Binding Active}"><ItemsControl.ItemTemplate><DataTemplate><local:SessionRow/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Separator Visibility="{Binding HasDivider, Converter={StaticResource BoolVisibility}}"/>
 <ItemsControl ItemsSource="{Binding Recent}"><ItemsControl.ItemTemplate><DataTemplate><local:SessionRow/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Button Content="{Binding MoreLabel}" Command="{Binding More}" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding HasMore, Converter={StaticResource BoolVisibility}}"/>
 <TextBlock Text="{Binding Empty}" Visibility="{Binding HasEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Meta}"><Style.Triggers><DataTrigger Binding="{Binding Missing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Amber}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel></Border>
</UserControl>
