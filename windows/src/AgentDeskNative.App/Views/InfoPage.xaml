<!-- macOS: PanelInfoView.swift -->
<UserControl x:Class="AgentDeskNative.Windows.InfoPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentDeskNative.Windows" >
<StackPanel>
 <StackPanel Orientation="Horizontal"><ContentControl local:Icon.Kind="accounts" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="账号与任务" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{DynamicResource info.0}" Margin="0,6,0,14"/>
 <StackPanel Orientation="Horizontal"><ContentControl local:Icon.Kind="quota" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="额度" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{DynamicResource info.1}" Margin="0,6"/><TextBlock Text="{DynamicResource info.2}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>
 <StackPanel Orientation="Horizontal"><ContentControl local:Icon.Kind="handoff" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="文档接力" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{DynamicResource info.3}" Margin="0,6,0,14"/>
 <StackPanel Orientation="Horizontal"><ContentControl local:Icon.Kind="desktop" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="桌面入口" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{DynamicResource info.4}" Margin="0,6,0,14"/>
 <Separator/><Expander Header="数据与限制"><StackPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource info.5}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><TextBlock Text="Claude 额度使用对应账号凭据，仅在内存中使用；只向官方服务请求用量。" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource info.7}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource info.9}" FontWeight="SemiBold"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource Meta}" Margin="0,4,0,8"/><Button Content="刷新客户端发现" Command="{Binding DiscoverAgain}" Style="{StaticResource StandardButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
 </StackPanel>
</UserControl>
