<!-- macOS: NSAlert in AccountCard.swift -->
<Window x:Class="AgentDeskNative.Windows.InlineDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="320" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="{DynamicResource PanelFill}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
 <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
 <TextBlock x:Name="Description" Margin="0,0,0,10"/>
 <TextBox x:Name="Input" MaxLength="80" Margin="0,0,0,12"/>
 <CheckBox x:Name="Recycle" Content="同时把数据目录移到回收站" Margin="0,0,0,12"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Style="{StaticResource StandardButton}" Margin="0,0,8,0"/><Button Content="确认" IsDefault="True" Style="{StaticResource AccentButton}" Click="Accept"/></StackPanel>
 </StackPanel></Border>
</Window>
