<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AgentDeskNative</AssemblyName>
    <RootNamespace>AgentDeskNative.Windows</RootNamespace>
    <Description>AgentDesk Native for Windows — local Codex and Claude account management</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentDeskNative.Core/AgentDeskNative.Core.csproj" />
    <Content Include="Resources/ClientIcons/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
