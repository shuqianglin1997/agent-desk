{
  "name": "agent-desk",
  "productName": "Catshelf",
  "version": "0.10.1-preview.1",
  "description": "A local desktop manager for AI coding accounts, session history, quotas, diagnostics, and installed tools.",
  "main": "src/main.js",
  "author": "hupo",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/shuqianglin1997/catshelf",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuqianglin1997/catshelf.git"
  },
  "bugs": {
    "url": "https://github.com/shuqianglin1997/catshelf/issues"
  },
  "scripts": {
    "cli": "node src/automation/cli.js",
    "start": "electron .",
    "signaling:start": "node services/signaling/index.js",
    "build:native": "node scripts/build-native-helpers.js",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:dir": "electron-builder --mac dir --publish never --config.mac.forceCodeSigning=false --config.mac.notarize=false --config.mac.hardenedRuntime=false --config.mac.identity=-",
    "build:mac:ci": "electron-builder --mac dir --universal --publish never --config.mac.forceCodeSigning=false --config.mac.notarize=false --config.mac.hardenedRuntime=false --config.mac.identity=-",
    "build:mac:test": "electron-builder --mac dmg --universal --publish never --config.mac.forceCodeSigning=false --config.mac.notarize=false --config.mac.hardenedRuntime=false --config.mac.identity=-",
    "install:mac:local": "node scripts/install-local-macos.js --preserve-clients",
    "build:win": "electron-builder --win --publish never",
    "build:win:release": "electron-builder --win --publish never --config.win.forceCodeSigning=true",
    "build:dir": "electron-builder --dir --publish never --config.mac.forceCodeSigning=false --config.mac.notarize=false --config.mac.hardenedRuntime=false --config.mac.identity=-",
    "verify:electron-package": "node scripts/verify-electron-package-integrity.js",
    "verify:mac-release": "bash scripts/verify-macos-release.sh release",
    "verify:win-portable-package": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/verify-windows-portable-package.ps1",
    "verify:win-release": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/verify-windows-release.ps1 -ReleaseDir release",
    "accept:ui": "node scripts/ui-acceptance.js",
    "accept:packaged": "node scripts/packaged-first-use-smoke.js",
    "check:docs": "node scripts/check-docs.js",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && node scripts/check-syntax.js",
    "test": "node scripts/run-tests.js",
    "test:ci:windows": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/windows-test-annotations.js --test-reporter-destination=stderr"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "build": {
    "beforePack": "scripts/build-native-helpers.js",
    "appId": "com.hupo.agentdesk",
    "productName": "Catshelf",
    "asar": true,
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/screenshots/**",
      "package.json",
      "build-info.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "AgentDeskInputHelper",
          "AgentDeskInputHelper.exe",
          "AgentDeskAppActivator"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExts": [
        ".exe"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
