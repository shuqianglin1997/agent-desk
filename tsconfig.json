{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/core/**/*.js",
    "types/*.d.ts"
  ]
}
