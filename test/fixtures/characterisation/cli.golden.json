        "interfaceVersion": 1,
        "commands": [
          {
            "name": "capabilities",
            "description": "Discover this interface, its parameters, boundaries and extension guide.",
            "parameters": {},
            "effects": "read-only"
          },
          {
            "name": "paths",
            "description": "Suggest the standard desktop data directory without reading it.",
            "parameters": {},
            "effects": "read-only"
          },
          {
            "name": "apps",
            "description": "List registered client capabilities, not installed or authenticated state.",
            "parameters": {},
            "effects": "read-only"
          },
          {
            "name": "tools",
            "description": "Discover fixed CLI launchers without executing them or checking updates.",
            "parameters": {},
            "effects": "read-only"
          },
          {
            "name": "profiles list",
            "description": "Read persisted local Profile metadata, without recovery or migration.",
            "parameters": {
              "user-data": {
                "type": "string",
                "description": "Absolute Catshelf userData directory (its folder is still named AgentDesk); never inferred from the shell client home.",
                "required": true
              }
            },
            "effects": "read-only"
          },
          {
            "name": "profiles inspect",
            "description": "Inspect one Profile, path availability and external configuration ownership.",
            "parameters": {
              "user-data": {
                "type": "string",
                "description": "Absolute Catshelf userData directory (its folder is still named AgentDesk); never inferred from the shell client home.",
                "required": true
              },
              "profile": {
                "type": "string",
                "description": "Exact local Profile ID returned by profiles list.",
                "required": true
              }
            },
            "effects": "read-only"
          },
          {
            "name": "sessions list",
            "description": "Scan one local Profile using the existing best-effort adapter; no transcript output.",
            "parameters": {
              "user-data": {
                "type": "string",
                "description": "Absolute Catshelf userData directory (its folder is still named AgentDesk); never inferred from the shell client home.",
                "required": true
              },
              "profile": {
                "type": "string",
                "description": "Exact local Profile ID returned by profiles list.",
                "required": true
              },
              "query": {
                "type": "string",
                "description": "Literal case-insensitive title or project filter.",
                "required": false
              },
              "limit": {
                "type": "integer",
                "description": "Page size.",
                "required": false,
                "minimum": 1,
                "maximum": 200,
                "default": 50
              },
              "offset": {
                "type": "integer",
                "description": "Offset in this scan, not a persistent cursor.",
                "required": false,
                "minimum": 0,
                "maximum": 1000000,
                "default": 0
              }
            },
            "effects": "read-only"
          },
          {
            "name": "sessions locate",
            "description": "Return the shared path/coordinate format; do not open files or modify clipboard.",
            "parameters": {
              "user-data": {
                "type": "string",
                "description": "Absolute Catshelf userData directory (its folder is still named AgentDesk); never inferred from the shell client home.",
                "required": true
              },
              "profile": {
                "type": "string",
                "description": "Exact local Profile ID returned by profiles list.",
                "required": true
              },
              "session": {
                "type": "string",
                "description": "Exact session ID returned by sessions list.",
                "required": true
              }
            },
            "effects": "read-only"
          },
          {
            "name": "sessions read",
            "description": "Read an exact local session as Markdown when the client supports transcript export.",
            "parameters": {
              "user-data": {
                "type": "string",
                "description": "Absolute Catshelf userData directory (its folder is still named AgentDesk); never inferred from the shell client home.",
                "required": true
              },
              "profile": {
                "type": "string",
                "description": "Exact local Profile ID returned by profiles list.",
                "required": true
              },
              "session": {
                "type": "string",
                "description": "Exact session ID returned by sessions list.",
                "required": true
              },
              "max-chars": {
                "type": "integer",
                "description": "Maximum Markdown characters.",
                "required": false,
                "minimum": 200,
                "maximum": 262144,
                "default": 32000
              }
            },
            "effects": "read-only"
          },
          {
            "name": "integration plan",
            "description": "Preflight existing client roots for registration; never writes configuration or applies a plan.",
            "parameters": {
              "user-data": {
                "type": "string",
                "description": "Absolute Catshelf userData directory (its folder is still named AgentDesk); never inferred from the shell client home.",
                "required": true
              },
              "app": {
                "type": "string",
                "description": "Registered client ID from apps.",
                "required": true
              },
              "profile-path": {
                "type": "string",
                "description": "Absolute client data directory.",
                "required": true
              },
              "session-root": {
                "type": "string",
                "description": "Absolute client configuration/session root.",
                "required": true
              }
            },
            "effects": "read-only"
          }
        ],
        "output": {
          "format": "json",
          "envelope": [
            "schemaVersion",
            "ok",
            "command",
            "data or error"
          ],
          "unknownFields": "ignore additive response fields"
